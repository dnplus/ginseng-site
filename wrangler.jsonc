{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ginseng-try-catch",
  "main": "./worker.ts",
  "account_id": "7910ab8eac2e72cc2c36430f438df708",
  "routes": [{"pattern": "ginseng.dnplus.dev", "custom_domain": true}],
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/studio", "/studio/*", "/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ginseng-try-catch",
    "database_id": "3c590143-3181-4838-805a-8429fcbeed36",
    "migrations_dir": "migrations"
  }],
  "send_email": [{
    "name": "CONTACT_EMAIL",
    "allowed_sender_addresses": ["ginseng@dnplus.dev"],
    "allowed_destination_addresses": ["dnplus@mail.grokbot.com"]
  }, {
    // Newsletter confirmation emails go to any subscriber, so this binding has no destination list; it can only send as
    // the newsletter address.
    "name": "NEWSLETTER_EMAIL",
    "allowed_sender_addresses": ["ginseng@dnplus.dev"]
  }],
  "vars": {
    "SITE_URL": "https://ginseng.dnplus.dev",
    "CF_ACCESS_TEAM_DOMAIN": "https://dnplus.cloudflareaccess.com",
    "CF_ACCESS_AUD": "542a3075a34bbdd246e8d0c6f5d263192d049f554c8bdb27096ff491f716eec5",
    // Resend segment ids (one per newsletter language). RESEND_API_KEY and RESEND_WEBHOOK_SECRET are secrets:
    // `wrangler secret put`. Until all three of key and segments are set, nothing is sent to Resend.
    "RESEND_SEGMENT_ZH_TW": "4e1f6cb2-e07a-451d-a54d-35111eefb5bb",
    "RESEND_SEGMENT_EN": "dba22944-9062-4921-8187-7ec1a2eadff8"
  }
}
