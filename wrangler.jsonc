{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ginseng-try-catch",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/studio", "/studio/*", "/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ginseng-try-catch",
    // Local-only placeholder. Replace with the UUID from pnpm db:create before deploying.
    "database_id": "00000000-0000-4000-8000-000000000000",
    "migrations_dir": "migrations"
  }],
  "send_email": [{
    "name": "CONTACT_EMAIL",
    "allowed_sender_addresses": ["ginseng@dnplus.dev"],
    "allowed_destination_addresses": ["dnplus@mail.grokbot.com"]
  }],
  "vars": {
    "SITE_URL": "",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": ""
  }
}
